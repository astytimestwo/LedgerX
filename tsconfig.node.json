{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "lib": [
            "ES2022"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/main/**/*.ts",
        "src/preload/**/*.ts",
        "src/shared/**/*.ts",
        "electron-builder.config.ts",
        "vite.config.ts"
    ]
}