{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.tsx",
        "src/shared/**/*.ts"
    ]
}